(include "input.scm")
(let loop ((machine0 (list 0 '((p . 0)) '() '()))
	   (machine1 (list 0 '((p . 1)) '() '()))
	   (cnt 0))
  (let* ((result0 (run program machine0))
	 (result1 (run program (list (car machine1) (cadr machine1) '() (reverse (caddr result0))))))
      (if (not (null? (caddr result1)))
          (loop (list (car result0) (cadr result0) '() (reverse (caddr result1))) result1 (+ cnt (length (caddr result1))))
          (begin
            (display cnt)
            (newline)))))
