(define (reg state sym)
  (let ((entry (assq sym state)))
    (if entry (cdr entry) 'invalid-register)))

(define (put state sym value)
  (cons (cons sym value) state))

(define (val state operand)
  (if (number? operand) operand (reg state operand)))

(define (exec instr pc state send recv)
  (let ((r (cadr instr))
        (v (if (null? (cddr instr)) '() (val state (caddr instr)))))
    (case (car instr)
      ((snd) (list (+ pc 1) state (cons (val state r) send) recv))
      ((set) (list (+ pc 1) (put state r v) send recv))
      ((add) (list (+ pc 1) (put state r (+ (reg state r) v)) send recv))
      ((mul) (list (+ pc 1) (put state r (* (reg state r) v)) send recv))
      ((mod) (list (+ pc 1) (put state r (modulo (reg state r) v)) send recv))
      ((rcv) (if (null? recv)
                 (list pc state send recv)
		 (list (+ pc 1) (put state r (car recv)) send (cdr recv))))
      ((jgz) (list (+ pc (if (> (val state r) 0) v 1)) state send recv)))))

(define (debug-print pc instr state)
  (begin (display pc) (display " ") (write instr)
	 (display " ") (write state) (newline)))

(define (run prog machine)
  (let* ((pc (car machine))
	 (instr (vector-ref prog pc))
         (result (apply exec (cons instr machine)))
         (new-pc (car result)))
      (if #f (debug-print pc instr result))
      (if (or (= pc new-pc) (< new-pc 0) (>= new-pc (vector-length prog)))
	  result
	  (run prog result))))

